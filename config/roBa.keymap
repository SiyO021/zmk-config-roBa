#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define L_BASE          0
#define L_MAC           1
#define L_FUNCTION      2
#define L_NUM           3
#define L_ARROW         4
#define L_MOUSE         5
#define L_SCROLL        6
#define L_CHANGE_DEVICE 7
#define L_SNIPE         8

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    // automouse-layer = <L_MOUSE>;

    scroll-layers = <L_SCROLL>;
    snipe-layers = <L_SNIPE>;

    // arrows {
    //     layers = <L_ARROW>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <8 9>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <32 33>;
        };

        multiply {
            bindings = <&kp ASTERISK>;
            key-positions = <20 21>;
        };

        trans {
            bindings = <&kp LC(SPACE)>;
            key-positions = <2 1>;
        };
    };

    macros {
//        to_layer_0: to_layer_0 {
//            compatible = "zmk,behavior-macro-one-param";
//            #binding-cells = <1>;
//            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
//            label = "TO_LAYER_0";
//        };
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to L_BASE>,
                <&macro_param_1to1>,
                <&kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
        select_win_profile: select_win_profile {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;

            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_param_1to2>,
                <&bt BT_SEL MACRO_PLACEHOLDER>,
                <&layer_off L_MAC>;
        };

        select_mac_profile: select_mac_profile {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;

            wait-ms = <0>;
            tap-ms = <0>;

            bindings =
                <&macro_param_1to2>,
                <&bt BT_SEL MACRO_PLACEHOLDER>,
                <&layer_on L_MAC>;
        };
    };

    behaviors {
        // scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
        //     compatible = "zmk,behavior-sensor-rotate";
        //     #sensor-binding-cells = <0>;
        //     bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        // 追加: スクロールのタップ時間を設定 (20ms)
        //     tap-ms = <20>;
        // };
        // rot_scroll: rot_scroll {
        //     compatible = "zmk,behavior-sensor-rotate-var";
        //     #sensor-binding-cells = <2>;
        //     bindings = <&msc>, <&msc>;
        //     tap-ms = <10>;   // 5–20ms目安
        // };

        enc_scroll: behavior_sensor_rotate {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <5>;     // 40–60の範囲で調整
        };

        enc_test: enc-test {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&kp A>, <&kp B>;

            tap-ms = <30>;
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        //test_rot: behavior_sensor_rotate {
        //    compatible = "zmk,behavior-sensor-rotate";
        //    #sensor-binding-cells = <0>;
        //    bindings = <&kp F20>, <&kp F21>;
        //    tap-ms = <40>;
        //};

        layer_on: layer_on {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "on";
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R             &kp T                                                                  &kp Y        &kp U  &lt L_SCROLL I  &kp O    &mt LSHFT P
&kp A             &kp S         &kp D         &kp F             &lt L_MOUSE G           &kp LS(LG(S))                   &kp SQT        &kp H        &kp J  &kp K           &kp L    &lt L_MOUSE MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V             &kp B                   &lt_to_layer_0 L_CHANGE_DEVICE BACKSLASH      &kp SEMICOLON  &kp N        &kp M  &kp COMMA       &kp DOT  &mt LCTRL SLASH
&lt L_FUNCTION ESCAPE      &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_CONTROL  &lt_to_layer_0 L_ARROW SPACE  &lt_to_layer_0 L_SNIPE TAB            &kp BACKSPACE  &lt L_NUM ENTER                             &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PAGE_DOWN PAGE_UP>;
        };

        mac_layer {
            display-name = "macOS";

            bindings = <
&trans  &trans            &trans  &trans        &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans            &trans  &trans        &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans            &trans  &trans        &trans  &trans      &trans  &trans  &trans  &trans  &trans  &mt LGUI SLASH
&trans  &kp LEFT_CONTROL  &trans  &kp LEFT_GUI  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp F1   &kp F2   &kp F3   &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F6   &kp F7   &kp F8   &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp F11  &kp F12  &kp F13  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                             &trans
            >;
        };

        NUM {
            bindings = <
&trans                   &kp N7        &kp N8        &kp N9        &kp MINUS                                  &kp AMPERSAND    &kp TILDE    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp CARET
&kp EQUAL                &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp SLASH     &trans          &kp GRAVE    &kp HASH         &kp AT_SIGN  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PERCENT
&mt LEFT_SHIFT NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp PERCENT   &kp PERIOD      &kp PERCENT  &kp EXCLAMATION  &kp DOLLAR   &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp BACKSLASH
&trans                   &trans        &trans        &kp CARET     &kp ASTERISK  &kp PLUS        &trans       &trans                                                                     &kp PIPE
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &kp TAB         &kp UP_ARROW    &kp LS(LEFT_ALT)  &kp LEFT_ALT                      &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW   &kp END       &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &trans          &kp LEFT_GUI    &kp LG(TAB)       &trans        &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans          &trans          &trans            &trans        &trans      &trans  &trans                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans    &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB5  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &mkp MB4  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                  &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        CHANGE_DEVICE {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &select_win_profile 0  &select_win_profile 1  &select_mac_profile 2  &select_win_profile 3  &select_win_profile 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR
            >;
        };

        SNIPE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
